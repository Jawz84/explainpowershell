{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "clean",
			"command": "dotnet",
			"args": [
				"clean",
				"/property:GenerateFullPaths=true",
				"/consoleloggerparameters:NoSummary"
			],
			"type": "process",
			"problemMatcher": "$msCompile"
		},
		{
			"label": "build",
			"command": "dotnet",
			"args": [
				"build",
				"/property:GenerateFullPaths=true",
				"/consoleloggerparameters:NoSummary"
			],
			"type": "process",
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": "$msCompile"
		},
		{
			"label": "func: host start",
			"type": "func",
			"options": {
				"cwd": "${workspaceFolder}/explainpowershell.analysisservice/"
			},
			"command": "host start",
			"isBackground": true,
			"problemMatcher": "$func-dotnet-watch",
			"dependsOn": "startstorageemulator"
		},
		{
			"label": "watch run frontend",
			"command": "dotnet",
			"args": [
				"watch",
				"run"
			],
			"type": "process",
			"problemMatcher": "$msCompile",
			"options": {
				"cwd": "${workspaceFolder}/explainpowershell.frontend/"
			},
			"dependsOn": "Open browser frontend"
		},
		{
			"label": "watch run backend",
			"command": "dotnet",
			"args": [
				"watch",
				"run",
				"--no-hot-reload"
			],
			"type": "process",
			"problemMatcher": "$msCompile",
			"options": {
				"cwd": "${workspaceFolder}/explainpowershell.analysisservice/",
				"env": {
					"DOTNET_USE_POLLING_FILE_WATCHER": "false"
				}
			},
			"dependsOn": "startstorageemulator"
		},
		{
			"label": "startstorageemulator",
			"command": "${command:azurite.start}",
			"isBackground": true
		},
		{
			"label": "Open browser frontend",
			"type": "shell",
			"command": "Start-Process https://localhost:5001",
			"problemMatcher": []
		}
	]	
}
